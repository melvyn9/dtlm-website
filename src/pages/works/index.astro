---
/**
 * Works index.
 *
 * URL is /works/ rather than the /projects/ proposed in brief §4 — the client
 * confirmed on 14 Aug 2026 that the existing WordPress URLs are preserved so
 * no accumulated search ranking is put at risk.
 *
 * Typology filtering is implemented as real, build-time URL routes at
 * /project-type/[typology]/ (§4). There is no client-side filter: with JS
 * disabled a client-side filter would leave an empty grid.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import DraftNotice from '../../components/DraftNotice.astro';
import { getProjects } from '../../lib/content';
import { TYPOLOGIES } from '../../consts.js';
import t from '../../i18n/en.js';
import { withBase } from '../../lib/url';

const projects = await getProjects();
const draftCount = projects.filter((p) => p.data.draft).length;

const used = new Set(projects.map((p) => p.data.typology));
const filters = TYPOLOGIES.filter((ty) => used.has(ty));
---

<BaseLayout
  title={t['works.title']}
  description={`Selected architectural work by ${'DTLM Architect'} — houses, civic buildings, commercial and interior projects across Malaysia and the region.`}
>
  <DraftNotice count={draftCount} />

  <div class="wrap section">
    <header class="page-head">
      <h1>{t['works.title']}</h1>
      <p class="meta">{t['works.count'](projects.length)}</p>
    </header>

    {
      filters.length > 1 && (
        <nav class="filters" aria-label={t['works.filterLabel']}>
          <ul>
            <li>
              <a href={withBase('/works/')} aria-current="page">
                {t['works.filterAll']}
              </a>
            </li>
            {filters.map((ty) => (
              <li>
                <a href={withBase(`/project-type/${ty}/`)}>{t[`typology.${ty}`]}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      projects.length > 0 ? (
        <ul class="grid">
          {projects.map((project, i) => (
            <li>
              <ProjectCard
                href={withBase(`/portfolio/${project.data.slug}/`)}
                title={project.data.title}
                location={project.data.location}
                year={project.data.year}
                typology={project.data.typology}
                heroImage={project.data.heroImage}
                heroImageAlt={project.data.heroImageAlt}
                priority={i === 0}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">
          No projects are published yet. Projects appear here once their content
          is complete and image rights are confirmed.
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-m);
    margin-block-end: var(--space-l);
  }

  .filters ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding-block-end: var(--space-m);
    margin-block-end: var(--space-xl);
    border-block-end: 1px solid var(--rule);
  }

  .filters a {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink-muted);
    display: inline-block;
    padding-block: var(--space-3xs);
    border-block-end: 1px solid transparent;
  }

  .filters a:hover,
  .filters a[aria-current='page'] {
    color: var(--ink);
    border-block-end-color: var(--ink);
  }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl) var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .empty {
    color: var(--ink-muted);
    max-width: var(--measure);
  }
</style>
