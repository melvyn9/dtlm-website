---
import BaseLayout from '../layouts/BaseLayout.astro';
import t from '../i18n/en.js';
import { withBase } from '../lib/url';
---

<BaseLayout title={t['error.404.title']} description="Page not found.">
  <div class="wrap section">
    <div class="prose">
      <h1>{t['error.404.title']}</h1>
      <p>{t['error.404.body']}</p>
      <ul>
        <li><a href={withBase('/#selected-works')}>Works</a></li>
        <li><a href={withBase('/#news')}>News &amp; Press</a></li>
        <li><a href={withBase('/#contact')}>Contact</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
