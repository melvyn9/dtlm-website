---
import BaseLayout from '../layouts/BaseLayout.astro';
import t from '../i18n/en.js';
---

<BaseLayout title={t['error.404.title']} description="Page not found.">
  <div class="wrap section">
    <div class="prose">
      <h1>{t['error.404.title']}</h1>
      <p>{t['error.404.body']}</p>
