---
/**
 * Contact.
 *
 * Brief §3: the form must be a plain <form action method="POST"> that submits
 * without JavaScript. It is NOT a fetch handler. There is a honeypot field
 * for spam.
 *
 * Brief §4: no embedded Google Maps iframe — a static map image linked to
 * Google Maps instead.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, FORM, SITE } from '../consts.js';
import t from '../i18n/en.js';
import { withBase } from '../lib/url';
---

<BaseLayout
  title={t['contact.title']}
  description={`Contact ${SITE.name}, Kuala Lumpur.`}
>
  {
    (!CONTACT.verified || !FORM.configured) && import.meta.env.DEV && (
      <div class="setup-notice" role="status">
        <div class="wrap">
          <strong>Setup incomplete.</strong>
          {!CONTACT.verified && ' Contact details are placeholders — confirm them in src/consts.js.'}
          {!FORM.configured && ' The form endpoint has no access key yet — see src/consts.js.'}
        </div>
      </div>
    )
  }

  <div class="wrap section">
    <header class="page-head">
      <h1>{t['contact.title']}</h1>
    </header>

    <div class="layout">
      <section class="details" aria-labelledby="contact-details">
        <h2 id="contact-details" class="visually-hidden">Contact details</h2>

        <dl>
          <div>
            <dt>{t['contact.address']}</dt>
            <dd>
              <address>
                {CONTACT.addressLines.map((line) => <span>{line}</span>)}
              </address>
            </dd>
          </div>

          <div>
            <dt>{t['contact.phone']}</dt>
            <dd>
              {
                CONTACT.phoneHref ? (
                  <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
                ) : (
                  CONTACT.phone
                )
              }
            </dd>
          </div>

          <div>
            <dt>{t['contact.emailLabel']}</dt>
            <dd>
              {
                CONTACT.email.startsWith('[') ? (
                  CONTACT.email
                ) : (
                  <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
                )
              }
            </dd>
          </div>
        </dl>

        <p class="map">
          <a href={CONTACT.mapLink} rel="noopener external">{t['contact.viewMap']}</a>
        </p>
      </section>

      <section class="form-section" aria-labelledby="enquiry">
        <h2 id="enquiry">{t['contact.formTitle']}</h2>

        <!--
          Plain HTML form POST. No JavaScript involved at any point (§2.1).
          Web3Forms redirects the browser to `redirect` on success, so the
          non-JS flow ends on a real page rather than a JSON response.
        -->
        <form action={FORM.endpoint} method="POST" class="form">
          <input type="hidden" name="access_key" value={FORM.accessKey} />
          <input type="hidden" name="redirect" value={FORM.redirectTo} />
          <input type="hidden" name="subject" value={`Website enquiry — ${SITE.name}`} />
          <input type="hidden" name="from_name" value={SITE.name} />

          <!--
            Honeypot (§3). Hidden from sighted users AND from screen readers
            via aria-hidden + tabindex, so it never traps a real person.
          -->
          <div class="honeypot" aria-hidden="true">
            <label for={FORM.honeypotField}>Leave this field empty</label>
            <input
              type="checkbox"
              id={FORM.honeypotField}
              name={FORM.honeypotField}
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <p class="form__hint" id="required-hint">
            Fields marked <abbr title="required">*</abbr> are required.
          </p>

          <div class="field">
            <label for="name">
              {t['contact.name']} <abbr title="required" aria-hidden="true">*</abbr>
            </label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="email">
              {t['contact.email']} <abbr title="required" aria-hidden="true">*</abbr>
            </label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="enquiry-subject">{t['contact.subject']}</label>
            <input type="text" id="enquiry-subject" name="enquiry_subject" />
          </div>

          <div class="field">
            <label for="message">
              {t['contact.message']} <abbr title="required" aria-hidden="true">*</abbr>
            </label>
            <textarea id="message" name="message" rows="7" required></textarea>
          </div>

          <button type="submit">{t['contact.submit']}</button>

          <p class="form__privacy">
            Your details are sent to the practice by email and are not used for
            anything else. See our <a href={withBase('/privacy/')}>privacy notice</a>.
          </p>
        </form>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .setup-notice {
    background: #3d2f00;
    color: #fff8e1;
    font-size: var(--step--1);
    padding-block: var(--space-2xs);
  }

  .page-head {
    margin-block-end: var(--space-xl);
  }

  .layout {
    display: grid;
    gap: var(--space-2xl) var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  dl {
    display: grid;
    gap: var(--space-m);
  }

  dt {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin-block-end: var(--space-3xs);
  }

  dd {
    margin: 0;
  }

  address {
    font-style: normal;
  }

  address span {
    display: block;
  }

  .map {
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
  }

  .form-section h2 {
    font-size: var(--step-1);
    margin-block-end: var(--space-m);
  }

  .form {
    display: grid;
    gap: var(--space-m);
    max-width: 34rem;
  }

  .form__hint {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
  }

  label {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    /* 3:1 non-text contrast on the border (WCAG 1.4.11) — verified in
       scripts/check-contrast.mjs. */
    border: 1px solid var(--ink-faint);
    background: var(--paper);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: 0;
    /* 16px minimum prevents iOS zooming the viewport on focus. */
    font-size: max(1rem, var(--step-0));
    min-height: 2.75rem;
  }

  textarea {
    resize: vertical;
  }

  abbr {
    text-decoration: none;
    color: var(--accent);
  }

  button {
    background: var(--accent);
    color: var(--paper);
    border: 0;
    padding: var(--space-xs) var(--space-l);
    font-size: var(--step-0);
    letter-spacing: 0.04em;
    cursor: pointer;
    justify-self: start;
    min-height: 2.75rem;
    transition: background var(--transition);
  }

  button:hover {
    background: var(--accent-hover);
  }

  .form__privacy {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Honeypot: visually removed but still submitted if a bot fills it. */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
