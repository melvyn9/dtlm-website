---
/**
 * The one-page site.
 *
 * Every former standalone page (works, portfolio detail, project-type,
 * about, team, news, contact) has been folded into an anchor section here.
 * Nav bar items in consts.js point at `/#section-id` anchors rather than
 * separate routes — see SiteHeader.astro / SiteFooter.astro.
 *
 * Project detail used to be its own page; it's now a same-DOM Popover-API
 * panel (ProjectPopover.astro) opened by a <button popovertarget> in
 * ProjectCard.astro. This is a native browser mechanism, not JavaScript —
 * it works identically with JS on or off, and never changes the URL,
 * matching the brief's zero-JS mandate the rest of this codebase holds to.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectPopover from '../components/ProjectPopover.astro';
import PressSection from '../components/PressSection.astro';
import PressList from '../components/PressList.astro';
import DraftNotice from '../components/DraftNotice.astro';
import { getProjects, getFeaturedProjects, getPress, getHero } from '../lib/content';
import { CONTACT, FORM, SITE } from '../consts.js';
import t from '../i18n/en.js';
import { withBase } from '../lib/url';

const allProjects = await getProjects();
const featured = await getFeaturedProjects(6);
const press = await getPress();
const draftCount =
  allProjects.filter((p) => p.data.draft).length + press.filter((p) => p.data.draft).length;

const heroImages = await getHero();

/**
 * Auto-advancing hero gallery — zero JavaScript.
 *
 * A single `translateX` @keyframes animation holds on each slide for
 * HERO_DWELL_S, then slides to the next over HERO_TRANSITION_S. Percentage
 * keyframe *selectors* can't be built from calc()/var() — they must be
 * literal numbers — so unlike everything else here (duration, pause state),
 * the @keyframes rule itself has to be generated as a string and injected
 * via a raw <style set:html> block below, separate from the normal scoped
 * <style> that holds the static track/slide/pause-control CSS.
 *
 * No explicit 100% stop is needed: CSS extends the last defined keyframe's
 * value forward automatically, which conveniently holds the final slide
 * steady until the animation loops. The loop restart (last slide → first)
 * is an instant cut, not an animated slide-back — standard for this pattern,
 * not a bug to design around.
 */
const HERO_DWELL_S = 5;
const HERO_TRANSITION_S = 0.7;

function heroKeyframes(n: number): string {
  const seg = HERO_DWELL_S + HERO_TRANSITION_S;
  const total = n * seg;
  const pct = (s: number) => ((s / total) * 100).toFixed(4);
  const stops: string[] = [];
  for (let i = 0; i < n; i++) {
    const holdStart = i * seg;
    const holdEnd = holdStart + HERO_DWELL_S;
    stops.push(`${pct(holdStart)}% { transform: translateX(-${i * 100}%); }`);
    stops.push(`${pct(holdEnd)}% { transform: translateX(-${i * 100}%); }`);
    if (i < n - 1) {
      stops.push(`${pct(holdStart + seg)}% { transform: translateX(-${(i + 1) * 100}%); }`);
    }
  }
  return `@keyframes hero-slide { ${stops.join(' ')} }`;
}

const heroAnimated = heroImages.length > 1;
const heroDuration = `${(heroImages.length * (HERO_DWELL_S + HERO_TRANSITION_S)).toFixed(2)}s`;

const awardItems = press.filter((p) => p.data.kind === 'award');
const publicationItems = press.filter((p) => p.data.kind === 'publication');
const speakingItems = press.filter((p) => p.data.kind === 'speaking');
const museumItems = press.filter((p) => p.data.kind === 'museum');
const bookItems = press.filter((p) => p.data.kind === 'book');
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} bareTitle>
  <DraftNotice count={draftCount} />

  <div class="wrap">
    <section class={`intro section ${heroImages.length > 0 ? 'intro--with-photo' : ''}`}>
      {
        heroImages.length > 0 && (
          <div class="intro__media">
            {heroAnimated && <input type="checkbox" id="hero-pause" class="visually-hidden" />}
            <div
              class={`intro__track ${heroAnimated ? 'intro__track--animated' : ''}`}
              style={heroAnimated ? `animation-duration: ${heroDuration};` : undefined}
            >
              {heroImages.map((slide) => (
                <div class="intro__slide">
                  <Image
                    src={slide.image}
                    alt={slide.alt}
                    widths={[600, 1000, 1600]}
                    sizes="100vw"
                    loading="eager"
                    fetchpriority="high"
                    format="avif"
                  />
                  {slide.caption && <p class="intro__caption">{slide.caption}</p>}
                </div>
              ))}
            </div>
            {heroAnimated && (
              <label for="hero-pause" class="intro__pause">
                <span class="intro__pause-icon intro__pause-icon--pause" aria-hidden="true">
                  <span /><span />
                </span>
                <span class="intro__pause-icon intro__pause-icon--play" aria-hidden="true" />
                <span class="visually-hidden">Pause automatic image rotation</span>
              </label>
            )}
          </div>
        )
      }

      <div class="intro__text">
        <h1 class="intro__statement">
          An architectural practice in Kuala Lumpur, working across houses,
          civic buildings and interiors.
        </h1>
        <p class="intro__lede">
          Led by {SITE.principal}, recipient of the PAM Gold Medal 2025.
        </p>
      </div>
    </section>
  </div>

  {
    heroAnimated && (
      <style set:html={heroKeyframes(heroImages.length)} />
    )
  }

  {
    featured.length > 0 && (
      <section id="selected-works" class="wrap section--tight" aria-labelledby="selected-works-heading">
        <h2 id="selected-works-heading">{t['home.selected']}</h2>
        <ul class="grid">
          {featured.map((project, i) => (
            <li>
              <ProjectCard
                slug={project.data.slug}
                title={project.data.title}
                location={project.data.location}
                year={project.data.year}
                typology={project.data.typology}
                heroImage={project.data.heroImage}
                heroImageAlt={project.data.heroImageAlt}
                priority={i === 0}
              />
            </li>
          ))}
        </ul>
        {featured.map((project) => <ProjectPopover project={project} />)}
      </section>
    )
  }

  {
    featured.length === 0 && (
      <section id="selected-works" class="wrap section--tight" aria-labelledby="selected-works-heading">
        <h2 id="selected-works-heading">{t['home.selected']}</h2>
        <p class="empty">
          No projects are published yet. Projects appear here once their
          content is complete and image rights are confirmed.
        </p>
      </section>
    )
  }

  <PressSection id="awards" heading={t['press.awards']} items={awardItems} />

  <PressSection id="news" heading={t['press.title']} items={publicationItems}>
    {
      speakingItems.length > 0 && (
        <div class="press-subgroup">
          <h3>{t['press.speaking']}</h3>
          <PressList items={speakingItems} />
        </div>
      )
    }
  </PressSection>

  <PressSection id="museums" heading={t['press.museums']} items={museumItems} />
  <PressSection id="books" heading={t['press.books']} items={bookItems} />

  <section id="contact" class="wrap section--tight" aria-labelledby="contact-heading">
    <h2 id="contact-heading">{t['contact.title']}</h2>

    {
      (!CONTACT.verified || !FORM.configured) && import.meta.env.DEV && (
        <div class="setup-notice" role="status">
          <strong>Setup incomplete.</strong>
          {!CONTACT.verified && ' Contact details are placeholders — confirm them in src/consts.js.'}
          {!FORM.configured && ' The form endpoint has no access key yet — see src/consts.js.'}
        </div>
      )
    }

    <div class="contact-layout">
      <section class="details" aria-labelledby="contact-details">
        <h3 id="contact-details" class="visually-hidden">Contact details</h3>

        <dl>
          <div>
            <dt>{t['contact.address']}</dt>
            <dd>
              <address>
                {CONTACT.addressLines.map((line) => <span>{line}</span>)}
              </address>
            </dd>
          </div>

          <div>
            <dt>{t['contact.phone']}</dt>
            <dd>
              {
                CONTACT.phoneHref ? (
                  <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
                ) : (
                  CONTACT.phone
                )
              }
            </dd>
          </div>

          <div>
            <dt>{t['contact.emailLabel']}</dt>
            <dd>
              {
                CONTACT.email.startsWith('[') ? (
                  CONTACT.email
                ) : (
                  <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
                )
              }
            </dd>
          </div>
        </dl>

        <p class="map">
          <a href={CONTACT.mapLink} rel="noopener external">{t['contact.viewMap']}</a>
        </p>
      </section>

      <section class="form-section" aria-labelledby="enquiry">
        <h3 id="enquiry">{t['contact.formTitle']}</h3>

        <!--
          Plain HTML form POST. No JavaScript involved at any point (§2.1).
          Web3Forms redirects the browser to `redirect` on success, so the
          non-JS flow ends on a real page rather than a JSON response.
        -->
        <form action={FORM.endpoint} method="POST" class="form">
          <input type="hidden" name="access_key" value={FORM.accessKey} />
          <input type="hidden" name="redirect" value={FORM.redirectTo} />
          <input type="hidden" name="subject" value={`Website enquiry — ${SITE.name}`} />
          <input type="hidden" name="from_name" value={SITE.name} />

          <!--
            Honeypot (§3). Hidden from sighted users AND from screen readers
            via aria-hidden + tabindex, so it never traps a real person.
          -->
          <div class="honeypot" aria-hidden="true">
            <label for={FORM.honeypotField}>Leave this field empty</label>
            <input
              type="checkbox"
              id={FORM.honeypotField}
              name={FORM.honeypotField}
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <p class="form__hint" id="required-hint">
            Fields marked <abbr title="required">*</abbr> are required.
          </p>

          <div class="field">
            <label for="name">
              {t['contact.name']} <abbr title="required" aria-hidden="true">*</abbr>
            </label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="email">
              {t['contact.email']} <abbr title="required" aria-hidden="true">*</abbr>
            </label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>

          <div class="field">
            <label for="enquiry-subject">{t['contact.subject']}</label>
            <input type="text" id="enquiry-subject" name="enquiry_subject" />
          </div>

          <div class="field">
            <label for="message">
              {t['contact.message']} <abbr title="required" aria-hidden="true">*</abbr>
            </label>
            <textarea id="message" name="message" rows="7" required></textarea>
          </div>

          <button type="submit">{t['contact.submit']}</button>

          <p class="form__privacy">
            Your details are sent to the practice by email and are not used for
            anything else. See our <a href={withBase('/privacy/')}>privacy notice</a>.
          </p>
        </form>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 40ch;
  }

  /*
   * Always stacked — media on top spanning the section's full width, text
   * below — not a side-by-side grid the way a single portrait used to sit.
   * A full-width band reads oddly at a tall portrait crop, so the media
   * aspect ratio is landscape (see .intro__media) rather than the old 4/5.
   */
  .intro--with-photo {
    max-width: none;
  }

  .intro__statement {
    font-size: var(--step-3);
  }

  .intro__lede {
    margin-block-start: var(--space-m);
    color: var(--ink-muted);
    font-size: var(--step-1);
    max-width: var(--measure);
  }

  .intro__text {
    max-width: var(--measure);
    margin-block-start: var(--space-l);
  }

  /* With a hero image present, the text block matches the image's full
     width and centers, rather than sitting at a left-aligned reading
     measure — the image sets the layout's scale here, not body-copy
     line-length conventions. */
  .intro--with-photo .intro__text {
    max-width: none;
    text-align: center;
  }

  .intro--with-photo .intro__lede {
    max-width: none;
  }

  .intro__media {
    position: relative;
    background: var(--paper-sunk);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .intro__track {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .intro__track--animated {
    /* animation-duration is set inline per-page (build-time computed from
       image count) — see the component frontmatter. It's a different
       longhand property from animation-name below, so the inline value and
       this stylesheet don't conflict, and the reduced-motion override still
       fully disables the animation regardless of the inline duration. */
    animation-name: hero-slide;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__track--animated {
      animation-name: none;
    }
  }

  .intro__slide {
    position: relative;
    flex: 0 0 100%;
  }

  .intro__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Bottom-left, mirroring .intro__pause's pill in the opposite corner —
     same "text-over-image" scrim treatment as .project-popover__count. */
  .intro__caption {
    position: absolute;
    bottom: var(--space-s);
    inset-inline-start: var(--space-s);
    /* Leaves room for the pause button in the opposite corner: this
       caption's own left inset, a gap, the button's width, and its own
       right inset — all --space-s, plus the button's 2.75rem diameter. */
    max-width: calc(100% - (var(--space-s) * 3) - 2.75rem);
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: 999px;
    background: var(--scrim);
    color: var(--paper);
    font-size: var(--step--1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ===================================================================
     Pause control — zero JavaScript. A visually-hidden checkbox drives
     animation-play-state on its sibling .intro__track via :checked, and
     swaps the label's pause/play icon the same way SiteHeader.astro swaps
     its hamburger ⇄ ✕ icon off #site-nav[open]. The checkbox must precede
     .intro__track in the DOM for the ~ sibling selector to reach it.
     =================================================================== */

  #hero-pause:checked ~ .intro__track {
    animation-play-state: paused;
  }

  .intro__pause {
    position: absolute;
    bottom: var(--space-s);
    inset-inline-end: var(--space-s);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--scrim);
    color: var(--paper);
    cursor: pointer;
  }

  .intro__pause:hover {
    background: var(--ink);
  }

  #hero-pause:focus-visible ~ .intro__pause {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  /* Icons drawn in CSS, no icon font/emoji dependency — same approach as
     the hamburger bars in SiteHeader.astro. */
  .intro__pause-icon--pause {
    display: flex;
    gap: 3px;
  }

  .intro__pause-icon--pause span {
    display: block;
    width: 3px;
    height: 13px;
    background: currentColor;
    border-radius: 1px;
  }

  .intro__pause-icon--play {
    display: none;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 7px 0 7px 11px;
    border-color: transparent transparent transparent currentColor;
    margin-inline-start: 3px;
  }

  #hero-pause:checked ~ .intro__pause .intro__pause-icon--pause {
    display: none;
  }

  #hero-pause:checked ~ .intro__pause .intro__pause-icon--play {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__pause {
      display: none;
    }
  }

  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl) var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  #selected-works > h2 {
    padding-block-end: var(--space-m);
    margin-block-end: var(--space-l);
    border-block-end: 1px solid var(--rule);
  }

  .empty {
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .press-subgroup {
    margin-block-start: var(--space-l);
  }

  .press-subgroup h3 {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    padding-block-end: var(--space-s);
    border-block-end: 1px solid var(--ink);
  }

  #contact > h2 {
    padding-block-end: var(--space-m);
    margin-block-end: var(--space-l);
    border-block-end: 1px solid var(--rule);
  }

  .setup-notice {
    background: #3d2f00;
    color: #fff8e1;
    font-size: var(--step--1);
    padding: var(--space-2xs) var(--space-m);
    margin-block-end: var(--space-l);
  }

  .contact-layout {
    display: grid;
    gap: var(--space-2xl) var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  dl {
    display: grid;
    gap: var(--space-m);
  }

  dt {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    margin-block-end: var(--space-3xs);
  }

  dd {
    margin: 0;
  }

  address {
    font-style: normal;
  }

  address span {
    display: block;
  }

  .map {
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
  }

  .form-section h3 {
    font-size: var(--step-1);
    margin-block-end: var(--space-m);
  }

  .form {
    display: grid;
    gap: var(--space-m);
    max-width: 34rem;
  }

  .form__hint {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .field {
    display: grid;
    gap: var(--space-3xs);
  }

  label {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    border: 1px solid var(--ink-faint);
    background: var(--paper);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: 0;
    font-size: max(1rem, var(--step-0));
    min-height: 2.75rem;
  }

  textarea {
    resize: vertical;
  }

  abbr {
    text-decoration: none;
    color: var(--accent);
  }

  button[type='submit'] {
    background: var(--accent);
    color: var(--paper);
    border: 0;
    padding: var(--space-xs) var(--space-l);
    font-size: var(--step-0);
    letter-spacing: 0.04em;
    cursor: pointer;
    justify-self: start;
    min-height: 2.75rem;
    transition: background var(--transition);
  }

  button[type='submit']:hover {
    background: var(--accent-hover);
  }

  .form__privacy {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
