---
/**
 * News, awards and press.
 *
 * Brief §5 — the client selected Option 2: a single curated page listing
 * awards, publications and speaking engagements with outbound links, rather
 * than a full migration of the WordPress post archive.
 *
 * Items live as Markdown in src/content/press/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import DraftNotice from '../components/DraftNotice.astro';
import { getPress, formatPressDate } from '../lib/content';
import t from '../i18n/en.js';

const press = await getPress();

const groups = [
  { kind: 'award', heading: t['press.awards'] },
  { kind: 'publication', heading: t['press.publications'] },
  { kind: 'speaking', heading: t['press.speaking'] },
] as const;
---

<BaseLayout
  title={t['press.title']}
  description="Awards, publications and speaking engagements — DTLM Architect and Ar. Dr. Tan Loke Mun."
>
  <DraftNotice />

  <div class="wrap section">
    <header class="page-head">
      <h1>{t['press.title']}</h1>
      <p class="lede">
        Awards, published coverage and speaking engagements. Links lead to the
        original publications.
      </p>
    </header>

    {
      groups.map((group) => {
        const items = press.filter((p) => p.data.kind === group.kind);
        if (items.length === 0) return null;
        return (
          <section class="group" aria-labelledby={`group-${group.kind}`}>
            <h2 id={`group-${group.kind}`}>{group.heading}</h2>
            <ul class="press-list">
              {items.map((item) => {
                const date = formatPressDate(item);
                return (
                  <li>
                    <span class="press-list__source">{item.data.source}</span>
                    <span class="press-list__title">
                      {item.data.url ? (
                        <a href={item.data.url} rel="noopener external">
                          {item.data.title}
                        </a>
                      ) : (
                        item.data.title
                      )}
                    </span>
                    <span class="press-list__date">{date ?? ''}</span>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-xl);
  }

  .lede {
    margin-block-start: var(--space-m);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .group + .group {
    margin-block-start: var(--space-xl);
  }

  .group h2 {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    padding-block-end: var(--space-s);
    border-block-end: 1px solid var(--ink);
  }

  .press-list {
    list-style: none;
    padding: 0;
  }

  .press-list li {
    display: grid;
    gap: var(--space-3xs) var(--space-m);
    grid-template-columns: minmax(9rem, 14rem) 1fr minmax(0, 12rem);
    padding-block: var(--space-m);
    border-block-end: 1px solid var(--rule);
    align-items: baseline;
  }

  @media (max-width: 50rem) {
    .press-list li {
      grid-template-columns: 1fr;
    }
  }

  .press-list__source {
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .press-list__title {
    font-size: var(--step-0);
  }

  .press-list__date {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
