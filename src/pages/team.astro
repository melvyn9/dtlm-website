---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DraftNotice from '../components/DraftNotice.astro';
import { getTeam } from '../lib/content';
import { render } from 'astro:content';
import t from '../i18n/en.js';

const team = await getTeam();
const rendered = await Promise.all(
  team.map(async (member) => ({ member, Content: (await render(member)).Content })),
);
const draftCount = team.filter((m) => m.data.draft).length;
---

<BaseLayout
  title={t['nav.team']}
  description="The people of DTLM Architect, led by Ar. Dr. Tan Loke Mun."
>
  <DraftNotice count={draftCount} />

  <div class="wrap section">
    <header class="page-head">
      <h1>{t['nav.team']}</h1>
    </header>

    {
      rendered.length > 0 ? (
        <ul class="people">
          {rendered.map(({ member, Content }) => (
            <li class="person">
              {member.data.headshot && member.data.headshotAlt && (
                <div class="person__media">
                  <Image
                    src={member.data.headshot}
                    alt={member.data.headshotAlt}
                    widths={[300, 600]}
                    sizes="(max-width: 40rem) 40vw, 18rem"
                    format="avif"
                  />
                </div>
              )}

              <div class="person__body">
                <h2>{member.data.name}</h2>
                <p class="person__role">{member.data.role}</p>

                {member.data.credentials.length > 0 && (
                  <ul class="person__credentials">
                    {member.data.credentials.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                )}

                <div class="prose person__bio">
                  <Content />
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Team profiles are being prepared.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-block-end: var(--space-xl);
  }

  .people {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .person {
    display: grid;
    gap: var(--space-m) var(--space-l);
    grid-template-columns: minmax(0, 18rem) minmax(0, var(--measure));
    padding-block-end: var(--space-xl);
    border-block-end: 1px solid var(--rule);
  }

  @media (max-width: 45rem) {
    .person {
      grid-template-columns: 1fr;
    }
  }

  .person__media {
    background: var(--paper-sunk);
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .person__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person h2 {
    font-size: var(--step-1);
  }

  .person__role {
    color: var(--ink-faint);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-block-start: var(--space-3xs);
  }

  .person__credentials {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-s);
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .person__bio {
    margin-block-start: var(--space-m);
  }

  .empty {
    color: var(--ink-muted);
  }
</style>
