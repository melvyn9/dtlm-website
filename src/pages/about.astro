---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts.js';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="About"
  description={`${SITE.name} is a Kuala Lumpur architectural practice led by ${SITE.principal}.`}
>
  <div class="wrap section">
    <div class="prose">
      <h1>About the practice</h1>

      <p class="lede">
        {SITE.name} is an architectural practice based in Kuala Lumpur, led by
        {SITE.principal}.
      </p>

      <!--
        STUB — brief §12: "Where a decision in §10 is unresolved, build the
        template and stub the content — flag it rather than inventing
        placeholder copy that might ship."

        Practice history and philosophy could not be sourced during the Phase 0
        audit: the existing site's robots.txt was returning HTTP 508 and the
        /about/ content was not readable. This copy must come from the practice.

        The two facts stated below are drawn from the project brief and are
        believed accurate, but should still be confirmed.
      -->

      <h2>Recognition</h2>
      <p>
        {SITE.principal} is the recipient of the PAM Gold Medal 2025, the
        Malaysian Institute of Architects' highest honour, and the practice
        received an Honorary Mention at the ARCASIA Awards for Architecture
        2025.
      </p>

      <h2>Philosophy</h2>
      <p>
        [TO BE SUPPLIED BY THE PRACTICE — practice history, approach and
        credentials. See the Phase 0 audit for what could not be recovered from
        the existing site.]
      </p>

      <p><a href={withBase('/team/')}>Meet the team</a> · <a href={withBase('/works/')}>View our work</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .lede {
    font-size: var(--step-1);
    color: var(--ink-muted);
  }
</style>
