---
/**
 * Full project detail, rendered as a native Popover-API panel.
 *
 * Opened by a <button popovertarget={`project-${slug}`}> elsewhere on the
 * page (see ProjectCard.astro) — `popover="auto"` gives light-dismiss
 * (Escape / outside click) and top-layer rendering with zero JavaScript,
 * the same "let the browser do the work" approach already used for the
 * mobile nav and the old project detail disclosure (both <details>-based).
 *
 * Calls render() itself, mirroring team.astro and the old portfolio/[slug]
 * page, rather than taking a rendered Content component as a prop.
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { Project } from '../lib/content';
import t from '../i18n/en.js';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const details = [
  { label: t['project.year'], value: String(d.year) },
  { label: t['project.location'], value: d.location },
  { label: t['project.status'], value: t[`status.${d.status}`] },
  { label: t['project.typology'], value: t[`typology.${d.typology}`] },
  d.area ? { label: t['project.area'], value: `${d.area} m²` } : null,
  d.client ? { label: t['project.client'], value: d.client } : null,
  { label: t['project.photography'], value: d.photographer },
].filter(Boolean) as { label: string; value: string }[];

const popoverId = `project-${d.slug}`;
const headingId = `${popoverId}-heading`;

/**
 * Hero image is slide 1; any gallery images follow, in the order the CMS's
 * list widget has them (drag-reordered there — see public/admin/config.yml).
 * A single-slide project (the common case today) renders with no carousel
 * chrome at all — see the `slides.length > 1` guards below.
 */
const slides = [{ image: d.heroImage, alt: d.heroImageAlt }, ...d.gallery];
---

<div popover="auto" id={popoverId} role="dialog" aria-modal="true" aria-labelledby={headingId} class="project-popover">
  <div class="project-popover__media">
    <div
      class="project-popover__track"
      tabindex={slides.length > 1 ? 0 : undefined}
      aria-label={slides.length > 1 ? `Project photos, ${slides.length} images` : undefined}
    >
      {
        slides.map((slide, i) => (
          <div class="project-popover__slide">
            <Image
              src={slide.image}
              alt={slide.alt}
              widths={[500, 900, 1300]}
              sizes="(max-width: 45rem) 90vw, 40rem"
              loading="lazy"
              format="avif"
            />
            {slides.length > 1 && (
              <span class="project-popover__count">{i + 1} / {slides.length}</span>
            )}
          </div>
        ))
      }
    </div>
    <button type="button" popovertarget={popoverId} popovertargetaction="hide" class="project-popover__close">
      <span aria-hidden="true">&times;</span>
      <span class="visually-hidden">{t['project.close']}</span>
    </button>
  </div>

  <div class="project-popover__body">
    <header class="project-popover__head">
      <h2 id={headingId}>{d.title}</h2>
      <p class="project-popover__meta">
        {d.location} <span aria-hidden="true">·</span> {d.year}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <h3 class="visually-hidden">{t['project.details']}</h3>
    <dl class="spec">
      {
        details.map((row) => (
          <div class="spec__row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      d.team.length > 0 && (
        <section class="project-popover__section">
          <h3>{t['project.team']}</h3>
          <ul>{d.team.map((m) => <li>{m}</li>)}</ul>
        </section>
      )
    }

    {
      d.consultants.length > 0 && (
        <section class="project-popover__section">
          <h3>{t['project.consultants']}</h3>
          <ul>{d.consultants.map((c) => <li>{c}</li>)}</ul>
        </section>
      )
    }

    {
      d.awards.length > 0 && (
        <section class="project-popover__section">
          <h3>{t['project.awards']}</h3>
          <ul>{d.awards.map((a) => <li>{a}</li>)}</ul>
        </section>
      )
    }

    {
      d.publications.length > 0 && (
        <section class="project-popover__section">
          <h3>{t['project.publications']}</h3>
          <ul>
            {d.publications.map((p) => (
              <li>
                {p.url ? (
                  <a href={p.url} rel="noopener external" aria-label={`${p.title} — ${t['press.external']}`}>
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
                {p.publisher && <span class="meta"> — {p.publisher}</span>}
                {p.date && <span class="meta"> ({p.date})</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</div>

<style>
  .project-popover {
    position: fixed;
    inset: var(--space-m);
    margin: auto;
    max-width: 48rem;
    max-height: calc(100vh - var(--space-xl));
    overflow-y: auto;
    border: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    padding: 0;
  }

  .project-popover::backdrop {
    background: var(--scrim);
  }

  .project-popover__media {
    position: sticky;
    top: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  /*
   * The actual scroller. Deliberately a separate element from
   * .project-popover__media, not the thing .project-popover__close is
   * positioned against — an absolutely positioned element still scrolls
   * with its containing block's own overflow (position:absolute only
   * exempts it from flex/grid *layout*, not from *scrolling*). Keeping the
   * close button a sibling of .track, both children of the non-scrolling
   * .project-popover__media, is what keeps it genuinely fixed in the corner
   * regardless of how far the gallery is scrolled.
   */
  .project-popover__track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  /* Scrollable region with no visible controls — must be reachable and
     operable by keyboard alone (axe: scrollable-region-focusable). Once
     focused, arrow keys scroll it natively in every major browser. tabindex
     is only present at all when there's more than one slide (see the
     component), so this rule only ever matches in that case. */
  .project-popover__track:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: -4px;
  }

  .project-popover__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    position: relative;
    background: var(--paper-sunk);
  }

  .project-popover__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-popover__count {
    position: absolute;
    bottom: var(--space-s);
    inset-inline-end: var(--space-s);
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: 999px;
    background: var(--scrim);
    color: var(--paper);
    font-size: var(--step--1);
  }

  .project-popover__close {
    position: absolute;
    top: var(--space-s);
    inset-inline-end: var(--space-s);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 0;
    background: var(--scrim);
    color: var(--paper);
    font-size: var(--step-1);
    cursor: pointer;
  }

  .project-popover__close:hover {
    background: var(--ink);
  }

  .project-popover__body {
    padding: var(--space-l);
    display: grid;
    gap: var(--space-l);
  }

  .project-popover__head {
    max-width: var(--measure);
  }

  .project-popover__meta {
    margin-block-start: var(--space-2xs);
    color: var(--ink-faint);
  }

  .spec {
    display: grid;
    gap: var(--space-2xs);
  }

  .spec__row {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) 1fr;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-block-end: 1px solid var(--rule);
  }

  .spec dt {
    color: var(--ink-faint);
    font-size: var(--step--1);
  }

  .spec dd {
    margin: 0;
  }

  .project-popover__section h3 {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin-block-end: var(--space-2xs);
  }

  .project-popover__section ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3xs);
  }
</style>
