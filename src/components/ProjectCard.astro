---
/**
 * Project card for the works index and homepage.
 *
 * Brief §4: "Each card: image, name, location, year."
 *
 * The whole card is not a link. Instead the project title is the link and it
 * is stretched over the card with a pseudo-element, so screen reader users
 * get one clear link with a meaningful name rather than an image and a title
 * announced as two separate links to the same place.
 */
import { Image } from 'astro:assets';
import t from '../i18n/en.js';

interface Props {
  slug: string;
  title: string;
  location: string;
  year: number;
  typology: string;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  /** First card on a page can eager-load to help LCP (§8). */
  priority?: boolean;
}

const { slug, title, location, year, typology, heroImage, heroImageAlt, priority = false } =
  Astro.props;
---

<article class="card">
  <div class="card__media">
    <Image
      src={heroImage}
      alt={heroImageAlt}
      widths={[400, 700, 1000, 1400]}
      sizes="(max-width: 40rem) 92vw, (max-width: 70rem) 46vw, 30vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      format="avif"
    />
  </div>

  <div class="card__body">
    <h3 class="card__title">
      <button type="button" popovertarget={`project-${slug}`}>{title}</button>
    </h3>
    <p class="card__meta">
      <span>{location}</span>
      <span aria-hidden="true">·</span>
      <span>{year}</span>
      <span aria-hidden="true">·</span>
      <span>{t[`typology.${typology}`]}</span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-s);
  }

  .card__media {
    overflow: hidden;
    background: var(--paper-sunk);
    aspect-ratio: 4 / 3;
  }

  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .card:hover .card__media :global(img) {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__media :global(img) {
      transform: none;
    }
  }

  .card__title {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .card__title button {
    /* Reset button chrome — this is a trigger, styled to read as a title. */
    border: 0;
    background: none;
    padding: 0;
    margin: 0;
    font: inherit;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
  }

  /* Stretch the trigger over the card so the whole card is clickable,
     without creating a second redundant control for screen readers. */
  .card__title button::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__title button:hover {
    color: var(--accent);
  }

  /* Because the trigger is stretched, focus must be shown on the whole card. */
  .card:has(button:focus-visible) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 6px;
  }

  .card__meta {
    font-size: var(--step--1);
    color: var(--ink-faint);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
</style>
