{
  "name": "dtlm-website",
  "version": "1.0.0",
  "description": "DTLM Architect — practice website. Static Astro site, zero client-side JavaScript on content pages.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
